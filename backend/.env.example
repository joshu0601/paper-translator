# Copy to backend/.env and adjust.

# ---- Database -------------------------------------------------------------
# Default: SQLite file under backend/data (zero setup).
# PostgreSQL + pgvector (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://paperai:paperai@localhost:5432/paperai

# ---- AI providers ---------------------------------------------------------
# mock = fully offline (extractive answers, glossary-only translation)
LLM_PROVIDER=mock            # openai | anthropic | mock
EMBEDDING_PROVIDER=mock      # openai | mock
TRANSLATION_PROVIDER=mock    # openai | anthropic | mock

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Thinking effort: low | medium | high | xhigh | max (empty = model default)
ANTHROPIC_EFFORT=
ANTHROPIC_TRANSLATION_EFFORT=medium

# ---- Storage --------------------------------------------------------------
STORAGE_BACKEND=local        # local | s3
# S3_BUCKET=
# S3_ENDPOINT_URL=            # e.g. Cloudflare R2 / Supabase endpoint
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Misc -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=50
TRANSLATION_BATCH_SIZE=8
RETRIEVAL_TOP_K=6
